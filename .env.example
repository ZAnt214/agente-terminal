# 复制为 .env 后填写本地值。
# VITE_ 前缀的变量会进入浏览器包，且必须同步声明在 src/env.ts；
# 其余变量为服务端专用，在托管环境中作为 Cloudflare secret 注入。

DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibe_web_template
LOG_DIR=./__happyseeds_web__

LLM_BASE_URL=example
LLM_API_KEY=xxx

# Reactus API 根地址（仅 scheme + host，不含路径；与沙箱内 REACTUS_BASE_URL 一致）
VITE_REACTUS_BASE_URL=https://dev-reactus-api.happyseeds.ai

# Happy Seeds（右下角水印校验与 PROJECT_ID）
VITE_HAPPYSEEDS_PROJECT_ID=

# Umami Analytics
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
